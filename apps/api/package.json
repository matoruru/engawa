{
  "name": "kaiwa-api",
  "version": "0.0.0",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e:usecases": "bun test test/e2e/usecases",
    "test:e2e:infra": "bun test test/e2e/infra",
    "test:e2e": "bun test test/e2e",
    "dev": "bun run --watch src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:restart": "docker compose restart",
    "db:logs": "docker compose logs -f postgres",
    "db:ps": "docker compose ps",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker exec -it chat-postgres psql -U chat -d chat",
    "db:sh": "docker exec -it chat-postgres sh",
    "db:migrate:new": "dbmate new",
    "db:migrate:up": "dbmate up",
    "db:migrate:rollback": "dbmate rollback",
    "db:migrate:status": "dbmate status",
    "db:migrate:wait": "dbmate wait",
    "db:migrate:dump": "dbmate dump"
  },
  "dependencies": {
    "better-auth": "^1.4.9",
    "elysia": "^1.4.19",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "bun-types": "latest",
    "dbmate": "^2.28.0",
    "ws": "^8.18.3"
  },
  "module": "src/index.js"
}
